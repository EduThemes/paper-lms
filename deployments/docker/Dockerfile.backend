# Build stage
# go1.26.x to match the go.mod `toolchain go1.26.4` directive (patched
# stdlib — see GO-2026-* in the toolchain comment). A 1.25 base would force
# `go build` to download the toolchain at build time; matching it here keeps
# the production binary on the patched stdlib with no build-time download.
FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-X main.Version=${VERSION}" -o /paper-lms ./cmd/server
RUN CGO_ENABLED=0 GOOS=linux go build -o /migrate ./cmd/migrate

# Run stage
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /paper-lms .
COPY --from=builder /migrate .

# NOTE (security follow-up): run as a non-root USER. Deferred until the
# compose layer makes the file-storage volume (/data/files) writable by that
# user — a named volume is root-owned by default, so a bare `USER app` would
# silently break uploads. Do it together with `user:`/an init-chown in
# docker-compose.prod.yml, then verify an upload end-to-end.
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3000/health || exit 1

CMD ["./paper-lms"]
